# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Google Gemini API (Recommended Free Tier: 1,500 requests/day free via Google AI Studio)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Anthropic Claude API (Alternative)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Database (PostgreSQL - Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/tarot"
DIRECT_URL="postgresql://user:password@localhost:5432/tarot"

# Auth (NextAuth / Supabase)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-key-32-chars-minimum-length"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe Billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Limits & Features
MAX_FOLLOWUP_QUESTIONS_PER_READING=5
DAILY_FREE_CREDITS=1
